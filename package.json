{
  "name": "unreal-mcp-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "MCP bridge for controlling the UE4.27 editor from Claude Code, OpenAI Codex, Google Gemini, and any other MCP client",
  "workspaces": [
    "mcp-server",
    "puerts-runtime"
  ],
  "scripts": {
    "build": "npm run build --workspace=puerts-runtime && node Scripts/stage-puerts-runtime.mjs --allow-missing-bundle && npm run build --workspace=mcp-server",
    "dev": "npm run dev --workspace=mcp-server",
    "test": "npm test --workspace=mcp-server",
    "test:integration": "npm run test:integration --workspace=mcp-server",
    "test:perf": "node Scripts/perf-stats.test.mjs",
    "test:orchestrator": "node Scripts/orchestrator.test.mjs",
    "doctor": "node Scripts/bridge-doctor.mjs",
    "check:puerts": "node Scripts/check-puerts-pin.mjs",
    "check:inventory": "node Scripts/generate-tool-inventory.mjs",
    "check:schema-budget": "node Scripts/check-schema-budget.mjs",
    "git:hygiene": "node Scripts/check-git-hygiene.mjs",
    "acceptance:graph-parity": "node Scripts/graph-parity-acceptance.mjs",
    "bench:schema": "node Scripts/bench-schema-sufficiency.mjs",
    "check:layout": "node Scripts/check-layout.mjs",
    "install:check": "node Scripts/bridge-install.mjs --check",
    "install:sync": "node Scripts/bridge-install.mjs --sync",
    "test:install": "node Scripts/bridge-install-acceptance.mjs",
    "test:fresh-install": "node Scripts/fresh-install-acceptance.mjs",
    "test:package": "node Scripts/package-acceptance.mjs",
    "test:security": "node Scripts/security-refusal-acceptance.mjs",
    "test:worktree-cleanup": "node Scripts/worktree-cleanup.test.mjs",
    "test:editor-free": "npm run test:security && npm run test:fresh-install && npm run test:package && npm run test:ue427-skill && npm run test:worktree-cleanup && npm run test:git-hygiene",
    "smoke": "node Scripts/mcp-smoke.mjs",
    "smoke:editor": "node Scripts/mcp-smoke.mjs --require-editor",
    "smoke:puerts": "node Scripts/puerts-live-smoke.mjs",
    "smoke:physics": "node Scripts/puerts-live-smoke.mjs --physics",
    "smoke:inspect": "node Scripts/graph-inspect-acceptance.mjs",
    "smoke:bt": "node Scripts/behavior-tree-acceptance.mjs",
    "test:bp-function": "node Scripts/bp-function-authoring-acceptance.mjs",
    "test:project-settings": "node Scripts/project-settings-patch-acceptance.mjs",
    "acceptance:editor": "node Scripts/editor-acceptance.mjs",
    "acceptance:quarantine": "node Scripts/quarantine-acceptance.mjs",
    "acceptance:preconditions": "node Scripts/precondition-acceptance.mjs",
    "acceptance:error-codes": "node Scripts/error-code-acceptance.mjs",
    "slice:gameplay": "node Scripts/slice-gameplay.mjs",
    "slice:ui": "node Scripts/slice-ui.mjs",
    "slice:ai": "node Scripts/slice-ai.mjs",
    "slice:animation": "node Scripts/slice-animation.mjs",
    "slice:materials": "node Scripts/slice-materials.mjs",
    "slice:level": "node Scripts/slice-level.mjs",
    "slice:cinematics": "node Scripts/slice-cinematics.mjs",
    "slice:summary": "node Scripts/slice-summary.mjs",
    "verify": "npm run build && npm test && npm run test:perf && npm run test:orchestrator && npm run check:puerts && npm run check:inventory && npm run check:schema-budget && npm run bench:schema && npm run git:hygiene && npm run smoke",
    "inspect": "mcp-inspector node mcp-server/dist/index.js",
    "inspect:list": "mcp-inspector --cli node mcp-server/dist/index.js --method tools/list",
    "ue427": "python Scripts/ue427.py",
    "test:ue427-skill": "python Scripts/ue427-skill-acceptance.py",
    "test:git-hygiene": "node Scripts/check-git-hygiene.test.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.0.0"
  }
}
