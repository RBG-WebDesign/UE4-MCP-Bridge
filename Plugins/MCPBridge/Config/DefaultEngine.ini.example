; Settings to add to your project's Config/DefaultEngine.ini.
;
; Scripts/install-mcp-bridge.ps1 writes these for you. Use this file only when
; you installed the plugin by hand, which is what you did if you extracted a
; release zip: the zip carries plugins and no project config.

; ---------------------------------------------------------------------------
; Native bridge. This is the one that matters.
; ---------------------------------------------------------------------------
;
; Every setting here has a default compiled into the plugin, so the bridge
; starts without this section. When PipeName is absent, the plugin derives a
; stable project-specific name from the .uproject name and canonical project
; path. Set PipeName only when you need an explicit override.

[MCPPuerTSBridge]
PipeName=\\.\pipe\UE427PuerTSMCP_<YourProjectName>

; ---------------------------------------------------------------------------
; Legacy HTTP/Python listener. Off by default, and it should stay off.
; ---------------------------------------------------------------------------
;
; Migration testing only. It is not a fallback for the native bridge, and it
; does nothing unless MCP_ENABLE_LEGACY_HTTP=1 is set before both UE4 and the
; MCP server start. Uncomment only if you were told to.
; Replace <ProjectRoot> with the absolute path to your project folder.

; [/Script/PythonScriptPlugin.PythonScriptPluginSettings]
; bDeveloperMode=True
; bRemoteExecution=True
; +StartupScripts=startup.py
; +AdditionalPaths=(Path="<ProjectRoot>/Plugins/MCPBridge/Content/Python")
