{
  "FileVersion": 3,
  "Version": 5,
  "VersionName": "0.5.0",
  "FriendlyName": "MCP Bridge",
  "Description": "Editor automation bridge for Unreal Engine 4.27 with a local MCP server, a native PuerTS execution lane, dockable status panel, and Blueprint graph builders. The legacy Python lane is optional and requires the host project to enable PythonScriptPlugin and EditorScriptingUtilities.",
  "Category": "Editor",
  "CreatedBy": "RareBird Games",
  "CreatedByURL": "https://github.com/RBG-WebDesign",
  "DocsURL": "https://github.com/RBG-WebDesign/UE4_Bridge",
  "MarketplaceURL": "",
  "SupportURL": "https://github.com/RBG-WebDesign/UE4_Bridge/issues",
  "EngineVersion": "4.27.0",
  "CanContainContent": true,
  "EnabledByDefault": false,
  "IsBetaVersion": false,
  "Installed": false,
  "Modules": [
    {
      "Name": "MCPBridgeEditorPanel",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "WhitelistPlatforms": [
        "Win64"
      ]
    },
    {
      "Name": "MCPBridgeGraphBuilder",
      "Type": "Editor",
      "LoadingPhase": "Default",
      "WhitelistPlatforms": [
        "Win64"
      ]
    },
    {
      "Name": "MCPBridgePIEAgent",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "WhitelistPlatforms": [
        "Win64"
      ]
    },
    {
      "Name": "MCPBridgeClothOptimizer",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "WhitelistPlatforms": [
        "Win64"
      ]
    },
    {
      "Name": "MCPBridgePuerTS",
      "Type": "Editor",
      "LoadingPhase": "PostEngineInit",
      "WhitelistPlatforms": [
        "Win64"
      ]
    }
  ],
  "Plugins": [
    {
      "Name": "Puerts",
      "Enabled": true
    }
  ],
  "IsExperimentalVersion": false
}
