# MCP bridge generated cache
Saved/MCP/index/
Saved/MCP/titles/
Saved/AgentScratch/

# UE project plugins are not part of this repo, except the unified bridge plugin.
# PuerTS is installed locally at Plugins/Puerts from the pinned Unreal_v1.0.9 bundle.
Plugins/*
!Plugins/MCPBridge/
# The PuerTS bundle itself is not tracked, but its pin manifest is the only
# recoverable record of what the bundle must contain. Keep it tracked.
!Plugins/Puerts.lock.json
# Never track build outputs inside the bridge plugin
Plugins/MCPBridge/Binaries/
Plugins/MCPBridge/Intermediate/
Plugins/MCPBridge/Saved/
# Generated by npm run build: tsc output from puerts-runtime plus the puerts/
# support subtree staged verbatim from the pinned bundle. See docs/PUERTS.md.
Plugins/MCPBridge/Content/JavaScript/

# Local release artifacts (uploaded to cloud storage, not tracked)
_releases/

# Release artifacts produced by Scripts/package-mcp-bridge.ps1 (over 100 MB:
# the vendored PuerTS bundle is in there)
Releases/

# Machine-local bridge paths (engine root, target project). Template:
# bridge.local.example.json. Written by Scripts/setup-unreal-project.ps1.
bridge.local.json
# Dedicated environment for the unreal-api MCP server.
# Created by Scripts/setup-unreal-api-mcp.ps1.
.venv-unreal-api/
