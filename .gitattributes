# Normalize line endings so checkouts behave the same on every platform.
# Source files are stored with LF; Windows-specific scripts keep CRLF.

* text=auto

*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.cs text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.uplugin text eol=lf
*.ini text eol=lf

# Git hooks are run by sh even on Windows. A CRLF checkout makes the shebang
# read "/usr/bin/env sh\r" and the hook dies with "bad interpreter", which looks
# like the hook is absent rather than broken. They have no extension, so
# text=auto above would otherwise hand them native line endings.
.githooks/* text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf

*.png binary
*.jpg binary
*.uasset binary
*.umap binary
